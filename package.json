{
  "name": "obsidian-embeddings",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=cjs --platform=node --target=es2022 --external:obsidian --external:electron --outfile=main.js",
    "typecheck": "tsc --noEmit",
    "check": "tsx test/check.ts",
    "deploy": "npm run build && D=\"${VAULT:?set VAULT to your vault path}/.obsidian/plugins/obsidian-embeddings\" && mkdir -p \"$D\" && cp main.js manifest.json styles.css \"$D/\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
